#include "xlnx_video.h"


XLV_AddrBase_TD      xlvo[XLV_ADDRBASE_NUMBER];


static void xlv_clear_addr_struct(XLV_AddrBase_TD)
{
    int i = 0;
    for(i=0;i<XLV_ADDRBASE_NUMBER;i++)
    {
        memset(&xlvo[i], 0x00, sizeof(XLV_AddrBase_TD));
    }
}


