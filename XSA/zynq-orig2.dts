						pins = "MIO7\0MIO8";
						bias-disable;
					};
				};

				i2c0-default {
					phandle = <0x0a>;

					mux {
						groups = "i2c0_10_grp";
						function = "i2c0";
					};

					conf {
						groups = "i2c0_10_grp";
						bias-pull-up;
						slew-rate = <0x00>;
						power-source = <0x01>;
					};
				};

				i2c0-gpio-grp {
					phandle = <0x0b>;

					mux {
						groups = "gpio0_50_grp\0gpio0_51_grp";
						function = "gpio0";
					};

					conf {
						groups = "gpio0_50_grp\0gpio0_51_grp";
						slew-rate = <0x00>;
						power-source = <0x01>;
					};
				};

				sdhci0-default {
