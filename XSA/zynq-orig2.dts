					};

					conf-mdio {
						groups = "mdio0_0_grp";
						slew-rate = <0x00>;
						power-source = <0x01>;
						bias-disable;
					};
				};

				gpio0-default {
					phandle = <0x09>;

					mux {
						function = "gpio0";
						groups = "gpio0_7_grp\0gpio0_8_grp\0gpio0_9_grp\0gpio0_10_grp\0gpio0_11_grp\0gpio0_12_grp\0gpio0_13_grp\0gpio0_14_grp";
					};

					conf {
